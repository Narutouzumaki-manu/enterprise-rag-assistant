# Docker Compose environment variables
# Copy this file to docker/.env (never commit it) or pass with --env-file when running docker compose.
# Compose refuses to start unless POSTGRES_PASSWORD, JWT_SECRET and OPENROUTER_API_KEY are set.

# PostgreSQL credentials (letters and digits only: the password is placed in a connection URL)
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag

# REQUIRED: random value of at least 32 characters
JWT_SECRET=
# REQUIRED: your OpenRouter API key
OPENROUTER_API_KEY=
# Optional: override the default free model
# OPENROUTER_MODEL=