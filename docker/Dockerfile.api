# syntax=docker/dockerfile:1

# Stage 1: Builder stage with build dependencies, wheels, and pre-downloaded embedding model
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download the embedding model so first start works completely offline
ENV HF_HOME=/opt/huggingface
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"

# Stage 2: Final runtime image (slim, no build tools, no tests, non-root user)
FROM python:3.12-slim AS runtime

# Install minimal runtime dependencies (curl for container healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root application user and group
RUN groupadd -r -g 10001 appuser && \
    useradd -r -u 10001 -g appuser -d /app -s /sbin/nologin appuser

WORKDIR /app

# Copy virtual environment and cached Hugging Face embedding model from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/huggingface /opt/huggingface

# Environment configuration
ENV PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/opt/huggingface \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy application source, migrations and entrypoints (tests and dev files excluded by .dockerignore)
COPY app /app/app
COPY scripts /app/scripts
COPY alembic.ini /app/alembic.ini

# Create directories for persistent storage and assign ownership to appuser
RUN mkdir -p /app/data/chroma /app/data/uploads && \
    chown -R appuser:appuser /app /opt/huggingface

USER appuser

EXPOSE 8000

# Start one uvicorn worker with proxy headers trusted from proxy network and graceful shutdown
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--timeout-graceful-shutdown", "10"]
