# Copy this file to .env and fill in the values. Never commit .env.

ENVIRONMENT=development

# Model access (Member 3's agent)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

# Connections (the defaults match docker/docker-compose.dev.yml)
DATABASE_URL=
REDIS_URL=

# Auth: in production use a random value of at least 32 characters
JWT_SECRET=