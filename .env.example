# Copy this file to .env and fill in the values. Never commit .env.
# A blank value means "use the default".

# Set to production to make the server refuse the development JWT secret.
ENVIRONMENT=development

# Model access (read by app/agents/llm.py, not by Settings)
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
# Free models come and go: a model that worked can start failing without notice.
# Last known to work (Session 28): nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional fallback models. Keep this short: each extra model can add up to about
# two minutes to one model call in the worst case.
OPENROUTER_FALLBACK_MODELS=

# Connections (development defaults)
DATABASE_URL=postgresql+asyncpg://rag:your_postgres_password_placeholder@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Storage
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads

# Limits
MAX_UPLOAD_MB=25
MAX_QUERY_CHARS=2000
INGEST_MAX_CONCURRENT=1

# Rate limits (starting values, tune from real use)
RATE_LIMIT_ENABLED=true
# Blank = use REDIS_URL. Tests use memory://
RATE_LIMIT_STORAGE_URL=
LOGIN_RATE_LIMIT=5/minute
CHAT_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=10/hour

# Agent runtime
AGENT_MAX_CONCURRENT=2
AGENT_WAIT_SECONDS=20.0
RETRY_AFTER_SECONDS=5
# false = start without the model and key (development only)
AGENT_ENABLED=true

# Streaming
SSE_HEARTBEAT_SECONDS=15.0

# Shutdown
SHUTDOWN_GRACE_SECONDS=30.0

# Authentication
# Required when ENVIRONMENT=production (minimum 32 characters).
JWT_SECRET=your_jwt_secret_placeholder_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
# true in production: one JSON object per line
LOG_JSON=false
