# syntax=docker/dockerfile:1

# Stage 1: Build the React single page application with Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Install package dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source files
COPY frontend/ ./

# Build production distribution assets
RUN npm run build

# Stage 2: Serve built assets using Nginx
FROM nginx:alpine AS runtime

# Remove default nginx static web pages
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom reverse proxy and routing configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Grant ownership to non-root nginx user where possible
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html /etc/nginx/nginx.conf

EXPOSE 80

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
